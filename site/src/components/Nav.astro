---
import { site } from '../data/site';
import { copy } from '../data/copy';
---

<div data-nav-sentinel aria-hidden="true"></div>
<header class="nav" data-nav>
  <div class="container inner">
    <a class="brand" href="/" aria-label={site.brand}>
      <span class="wordmark" aria-hidden="true">
        <span class="wordmark-face">{site.brand}</span>
        <span class="wordmark-face wordmark-back">{[...site.brand].reverse().join('')}</span>
      </span>
    </a>
    <nav class="actions" aria-label="사이트">
      <a class="btn btn-outline" href={site.repo}>{copy['nav-github']}</a>
      <a class="btn btn-outline" href={site.releasesLatest} data-download data-preview-label>{copy['nav-cta']}</a>
    </nav>
  </div>
</header>

<style>
  [data-nav-sentinel] {
    height: 1px;
  }
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    transition: background 0.2s, box-shadow 0.2s;
  }
  .nav.is-scrolled {
    background: rgba(251, 251, 248, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 var(--line);
  }
  @supports not (backdrop-filter: blur(8px)) {
    .nav.is-scrolled {
      background: var(--bg);
    }
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
  }
  .wordmark {
    display: grid;
    perspective: 360px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-align: center;
    pointer-events: none;
  }
  /* 두 면을 90도씩 나눠 회전해 WebKit의 뒷면 글자 겹침 방지. */
  .wordmark-face {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: rotateY(0deg);
    transition: transform 0.3s ease-in-out 0.3s;
  }
  .wordmark-back {
    transform: rotateY(-90deg);
    transition-delay: 0s;
  }
  .brand:focus-visible .wordmark-face {
    transform: rotateY(90deg);
    transition-delay: 0s;
  }
  .brand:focus-visible .wordmark-back {
    transform: rotateY(0deg);
    transition-delay: 0.3s;
  }
  @media (hover: hover) {
    .brand:hover .wordmark-face {
      transform: rotateY(90deg);
      transition-delay: 0s;
    }
    .brand:hover .wordmark-back {
      transform: rotateY(0deg);
      transition-delay: 0.3s;
    }
  }
  /* GitHub·다운로드를 오른쪽에 한 쌍으로. 테두리 유무로만 위계를 둠. */
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .actions .btn {
    min-width: 104px;
    justify-content: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .wordmark-face {
      transition: none;
    }
  }
  @media (max-width: 419px) {
    .inner {
      gap: 12px;
    }
    .actions {
      gap: 4px;
    }
    .actions .btn {
      min-width: 0;
      padding: 0 10px;
    }
  }
  @media (max-width: 359px) {
    .actions .btn {
      padding-inline: 6px;
    }
  }
</style>
