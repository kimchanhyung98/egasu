---
// 현재 앱의 탭·섹션 순서 재현. 시스템 작업은 안내만 표시.
import Glyph from './Glyph.astro';
import { settingGroups, settingsTabs, alertConditions, languageTags } from '../../data/settings';
import { initialPreviewState } from '../../data/preview-state';

interface Props { nav: boolean; uid: string }
const { nav, uid } = Astro.props;
const preferences = initialPreviewState().preferences;
const groups = settingGroups.map((group) => ({ ...group, rows: group.rows.map((row) => ({ ...row,
  control: row.control.kind === 'picker' ? { ...row.control, value: String(preferences[row.id]) } : row.control,
})) }));
---

{settingsTabs.map((tab) => (
  <div class="am-screen" id={`${uid}-settings-panel-${tab}`} role="tabpanel" aria-labelledby={`${uid}-settings-tab-${tab}`} data-settings-panel={tab} hidden={tab !== 'General'}>
    {groups.filter((group) => group.tab === tab).map((g) => (
      <div class="am-group" data-settings-group={g.id}>
        <b>
          {g.title}

        </b>
        <div class="am-list">
          {g.rows.filter(() => g.id !== 'conditions').map(({ id, label, control, info, note, requires }) => (
            <>
              <div class:list={['am-item', { 'am-action-row': !label }]} data-requires={requires} hidden={Boolean(requires)}>
                {label && <span class="am-item-label">
                  {label}
                  {info && <span class="am-setting-info" tabindex="0" aria-label={info}><Glyph name="info" class="am-accessory" /><span role="tooltip">{info}</span></span>}
                </span>}
                <span class="am-item-ctl">
                  {control.kind === 'toggle' &&
                    (nav ? (
                      <button type="button" class:list={['am-toggle', { 'is-on': control.on }]} role="switch" aria-checked={control.on ? 'true' : 'false'} data-setting={id} aria-label={id === 'softLimitEnabled' ? 'Enable Soft Limit' : undefined}>
                        <span class="am-sr">{label}</span>
                      </button>
                    ) : (
                      <span class:list={['am-toggle', { 'is-on': control.on }]} role="img" aria-label={control.on ? 'On' : 'Off'} />
                    ))}
                  {control.kind === 'action' && <button type="button" class="am-chip" data-native-action={control.message}>{control.label}</button>}
                  {control.kind === 'number' && <span class="am-number-wrap"><input class="am-number" type="number" min={control.min} max={control.max} step="1" value={control.value} aria-label={label} data-number-setting={id} disabled={!nav} /><span>%</span></span>}
                  {control.kind === 'picker' &&
                    (nav ? (
                      <span class="am-pickwrap">
                        <button type="button" class="am-picker" data-picker={id} aria-label={label} aria-haspopup="menu" aria-expanded="false" aria-controls={`${uid}-pick-${id}`}>
                          <span data-picker-value lang={id === 'language' ? languageTags[control.value] : undefined}>{control.value}</span>
                          <Glyph name="updown" />
                        </button>
                        <ul class="am-menu am-pickmenu" id={`${uid}-pick-${id}`} role="menu" aria-label={label} hidden>
                          {control.options.map((o) => (
                            <li role="none">
                              <button type="button" role="menuitemradio" aria-checked={o === control.value ? 'true' : 'false'} data-pick={id} data-value={o} lang={id === 'language' ? languageTags[o] : undefined}>
                                <Glyph name="check" class="am-check" />
                                {o}
                              </button>
                            </li>
                          ))}
                        </ul>
                      </span>
                    ) : (
                      <span class="am-picker">
                        <span lang={id === 'language' ? languageTags[control.value] : undefined}>{control.value}</span>
                        <Glyph name="updown" />
                      </span>
                    ))}
                </span>
              </div>
              {note && <p class="am-note" data-language-notice={id === 'language' ? true : undefined}>{note}</p>}
            </>
          ))}
          {g.id === 'conditions' && <>
            <div class="am-alert-columns"><span>Condition</span><span>Show in Priority</span><span>Receive Alerts</span></div>
            {alertConditions.map((condition) => <div class="am-alert-columns">
              <span>{condition.label}</span>
              {condition.shown ? <button type="button" class="am-toggle is-on" role="switch" aria-checked="true" data-setting={condition.shown} aria-label={`${condition.label}, Show in Priority`} /> : <span class="am-note">Always Shown</span>}
              <button type="button" class="am-toggle" role="switch" aria-checked="false" data-setting={condition.notify} aria-label={`${condition.label}, Receive Alerts`} />
            </div>)}
          </>}
          {g.id === 'menuBar' && <div class="am-menu-bar-preview" data-menu-bar-preview role="region" aria-label="Menu Bar Preview" />}
          {g.id === 'softLimit' && <>
            <details data-requires="softLimitEnabled" hidden><summary>Cancellation Status</summary><p class="am-note">Automatic cancellation is currently unavailable.</p></details>
            <details><summary>Connect Codex</summary><p class="am-note">Start the local server, then open a Codex terminal connected to it:</p><pre class="am-note"><code>codex app-server daemon start<br />codex --remote unix://</code></pre></details>
            <p class="am-note">The Codex cancellation connection has been tested, but automatic cancellation is unavailable until account scope is verified. Other Codex sessions and other providers are not protected yet.</p>
          </>}
          {g.id === 'icloud' && <p class="am-note" data-icloud-preview hidden>iCloud syncing is available in the Mac app. This preview does not share data.</p>}
          {g.id === 'notifications' && <div class="am-item am-action-row" data-notification-permission hidden><button type="button" class="am-chip" data-native-action="Allow notifications in the Mac app to receive usage alerts.">Allow Notifications</button></div>}
        </div>
      </div>
    ))}
  </div>
))}
