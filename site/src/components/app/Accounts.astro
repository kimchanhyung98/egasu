---
import Glyph from './Glyph.astro';
import { providers } from '../../data/providers';
import { accountFamilies } from '../../data/accounts';
import { initialPreviewState } from '../../data/preview-state';
interface Props { onboarding?: boolean }
const { onboarding = false } = Astro.props;
const initial = initialPreviewState();
---
<div class="am-screen">
  {onboarding ? <>
    <p class="am-account-empty" data-tour-accounts-empty>No Accounts</p>
    <div class="am-list" data-tour-account hidden><div class="am-prow"><Glyph name="grip" class="am-grip" /><svg class="am-mark" viewBox="0 0 24 24" aria-hidden="true"><use href="#pi-claude" /></svg><span>Claude</span><span>Account 1</span><span class="am-plan">In Use</span><Glyph name="chevron-right" class="am-chev" /></div></div>
  </> : <div class="am-list" data-account-list>
    {providers.flatMap((provider) => {
      const family = accountFamilies.find((family) => family.id === provider.id);
      return (family?.profiles ?? [{ id: 'default', name: '' }]).map((account) => {
        const label = [provider.name, account.name].filter(Boolean).join(' ');
        return (
          <div class="am-prow" data-account-list-row data-provider={provider.id} data-account-id={account.id}
            data-open={`account:${provider.id}:${account.id}`} hidden={!initial.enabledProviders.includes(provider.id)}>
            <span class="am-drag" draggable="true" data-drag-account={`${provider.id}:${account.id}`} tabindex="0" role="button" aria-keyshortcuts="ArrowUp ArrowDown">
              <Glyph name="grip" class="am-grip" /><span class="am-sr" data-account-action-label="Reorder">{`Reorder ${label}`}</span>
            </span>
            <svg class="am-mark" viewBox="0 0 24 24" aria-hidden="true"><use href={`#pi-${provider.id}`} /></svg>
            <button type="button" class="am-account-open" data-go={`account:${provider.id}:${account.id}`}>
              <span>{provider.name}</span>{account.name && <span data-account-name={provider.id} data-account-id={account.id}>{account.name}</span>}
            </button>
            {family && <span class="am-plan" data-in-use={provider.id} data-account-id={account.id} hidden={family.activeAccount !== account.id}>In Use</span>}
            <button type="button" class="am-open" data-go={`account:${provider.id}:${account.id}`}>
              <Glyph name="chevron-right" class="am-chev" /><span class="am-sr" data-account-action-label="Open">{`Open ${label}`}</span>
            </button>
          </div>
        );
      });
    })}
  </div>}
  {!onboarding && <p class="am-account-empty" data-accounts-empty hidden>No Accounts</p>}
</div>
