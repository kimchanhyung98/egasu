---
import type { Row } from '../../data/demo';
import { metricID, isSharedMetric } from '../../data/metrics';
import Meter from './Meter.astro';
import Forecast from './Forecast.astro';
import ResetCredits from './ResetCredits.astro';
interface Props { r: Row; provider: string; accountID: string; uid: string }
const { r, provider, accountID } = Astro.props;
const metric = metricID(provider, r.label)!;
const noData = (r.kind === 'text' && r.values.includes('No data')) || (r.kind === 'bounded' && r.noData);
---
<div class="am-metric-wrap" data-row={metric} data-account-id={accountID} data-provider={provider} data-shared={String(isSharedMetric(metric))} data-no-data={String(Boolean(noData))} hidden={noData}>
  {r.kind === 'bounded' && <Meter r={r} metric={metric} />}
  {r.kind === 'forecast' && <Forecast r={r} metric={metric} />}
  {r.kind === 'text' && metric === 'codex.rateLimitResets' && <ResetCredits metric={metric} />}
  {r.kind === 'text' && metric !== 'codex.rateLimitResets' && <div class="am-trow" data-metric={metric} tabindex="0"><b>{r.label}</b><span class="am-trow-val">{r.values.join(' · ')}</span></div>}
  {r.kind === 'trend' && <div class="am-trow am-trend" data-metric={metric} tabindex="0"><b>{r.label}</b><span class="am-spark" aria-label="Usage Trend">{r.bars.map((height) => <i class={`am-h${Math.round(height * 100)}`} />)}</span></div>}
</div>
