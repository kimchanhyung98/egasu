---
// W에서 Accounts 상세를 연결하기 전까지 Customize 경로 사용.
import Glyph from './Glyph.astro';
import { providerMetrics } from '../../data/metrics';

interface Props { provider: string; nav: boolean }
const { provider, nav } = Astro.props;
const m = providerMetrics[provider];
const groups: Array<[string, typeof m.rows]> = [['Metrics', m.rows]];
---

<div class="am-screen">
  {
    groups.map(([title, rows]) => (
      <div class="am-group">
        <b>{title}</b>
        <div class="am-list">
          {rows.map((r) => (
            <div class="am-mrow">
              <span class="am-mrow-title">{r.title}</span>
              {r.pinnable &&
                (nav ? (
                  <button
                    type="button"
                    class:list={['am-star', { 'is-on': r.starred }]}
                    aria-pressed={r.starred ? 'true' : 'false'}
                    data-star={r.id}
                    data-provider={provider}
                  >
                    <Glyph name="pin" />
                    <span class="am-sr">Pin {r.title}</span>
                  </button>
                ) : (
                  <span class:list={['am-star', { 'is-on': r.starred }]} role="img" aria-label={r.starred ? 'Pinned' : 'Not Pinned'}>
                    <Glyph name="pin" />
                  </span>
                ))}
              {nav ? (
                <button
                  type="button"
                  class:list={['am-toggle', { 'is-on': r.enabled }]}
                  role="switch"
                  aria-checked={r.enabled ? 'true' : 'false'}
                  data-metric-toggle={r.id}
                >
                  <span class="am-sr">{r.title}</span>
                </button>
              ) : (
                <span class:list={['am-toggle', { 'is-on': r.enabled }]} role="img" aria-label={r.enabled ? 'On' : 'Off'} />
              )}
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
