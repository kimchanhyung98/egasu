---
import { initialPreviewState } from '../../data/preview-state';
import { priorityBoard, dashboardLines } from '../../data/preview-dashboard';
import { providers } from '../../data/providers';
import { accountFamilies } from '../../data/accounts';
const state = initialPreviewState();
const board = priorityBoard(state);
const lines = dashboardLines(state).filter((line) => line.row.kind !== 'trend');
const groups = [
  { id: 'pinned', title: 'Pinned', items: board.pinned },
  { id: 'runningOut', title: 'Running Out', items: board.runningOut },
  { id: 'useItOrLoseIt', title: 'Use It or Lose It', items: board.useItOrLoseIt },
  { id: 'usedUp', title: 'Used Up', items: board.usedUp },
  { id: 'idle', title: '', items: lines.filter((line) => !line.pinned && !line.group) },
];
---
<div class="am-priority">
  {groups.map((group) => <section data-priority-group={group.id} hidden={group.id === 'idle' || !group.items.length}>
    <h3>{group.title}</h3>
    <div class="am-priority-items">
      {group.items.map((line) => {
        const row = line.row;
        const bounded = row.kind === 'bounded';
        const fraction = bounded ? row.used / row.limit : row.kind === 'forecast' ? row.probability / 100 : 0;
        const family = accountFamilies.find((family) => family.id === line.provider);
        const name = family?.profiles.find((profile) => profile.id === line.accountID)?.name;
        return <div class="am-priority-row" data-priority-key={line.key} data-line-id={line.id} data-provider={line.provider} data-account-id={line.accountID} data-severity={line.severity} data-spent={String(line.group === 'usedUp')} tabindex="0" aria-label={`${providers.find((provider) => provider.id === line.provider)?.name} ${row.label}`}>
          <span class="am-priority-ring" data-ring-value={fraction}>
            <svg class="am-priority-track" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" class="am-ring-track" /><circle cx="20" cy="20" r="17" class="am-ring-progress" stroke-dasharray={`${fraction * 106.81} 106.81`} />{bounded && row.used < row.limit && <line class="am-ring-pace" x1="34" y1="20" x2="40" y2="20" transform={`rotate(${row.elapsed * 360} 20 20)`} />}</svg>
            <svg class="am-priority-provider" viewBox="0 0 24 24" aria-hidden="true"><use href={`#pi-${line.provider}`} /></svg>
          </span>
          <span class="am-priority-text"><b>{row.label}</b>
            <span class="am-priority-account"><span>{providers.find((provider) => provider.id === line.provider)?.name}</span>{name && <span class="am-account-label" data-account-name={line.provider} data-account-id={line.accountID}>{name}</span>}</span>
          </span>
          <span class="am-priority-detail">
            {bounded ? <><span class="am-priority-status">Used Up</span><button type="button" class="am-priority-value am-headline" data-toggle-meter><span class="u">{Math.round(fraction * 100)}% used</span><span class="l">{Math.round((1 - fraction) * 100)}% left</span></button></>
              : <span class="am-priority-plain">{row.kind === 'text' ? row.values[0] : row.kind === 'forecast' ? `${row.probability}% chance` : ''}</span>}
            {(bounded || row.kind === 'forecast') && (row.resetRelative || row.resetAbsolute) && <button type="button" class="am-priority-note am-reset" data-toggle-reset><span class="abs" data-preview-time={row.resetAbsolute?.replace(/^Resets /, '')}>{row.resetAbsolute?.replace(/^Resets /, '')}</span><span class="rel">{row.resetRelative?.replace(/^(Resets in |Within )/, '')}</span></button>}
          </span>
        </div>;
      })}
    </div>
  </section>)}
  <section data-priority-notices hidden><h3>Needs Attention</h3>
    {providers.map((provider) => <div class="am-priority-notice" data-priority-notice={provider.id} hidden><span><b>{provider.name}</b><span>No sample usage for this provider.</span></span><button type="button" class="am-chip" data-go={`metrics:${provider.id}`}>Customize…</button></div>)}
  </section>
  <section data-all-clear hidden={!board.allClear}><h3>Running Out</h3><div class="am-clear-row"><span class="am-clear-icon">✓</span><span><b>All Clear</b><span>Nothing is running out.</span></span></div></section>
  <div class="am-clear" data-no-limits hidden={!board.noLimits}><b>No Reported Limits</b><button type="button" class="am-chip" data-dashboard-tab="All Usage">View All Usage</button></div>
</div>
