---
import { initialPreviewState } from '../../data/preview-state';
import { priorityBoard, dashboardLines, priorityGauge } from '../../data/preview-dashboard';
import { providers } from '../../data/providers';
import { accountFamilies } from '../../data/accounts';
interface Props { providerIDs: string[] }
const { providerIDs } = Astro.props;
const state = initialPreviewState();
state.enabledProviders = state.enabledProviders.filter((provider) => providerIDs.includes(provider));
const board = priorityBoard(state);
const lines = dashboardLines({ ...state, enabledProviders: providerIDs }).filter((line) => line.row.kind !== 'trend');
const groups = [
  { id: 'pinned', title: 'Pinned', items: board.pinned },
  { id: 'runningOut', title: 'Running Out', items: board.runningOut },
  { id: 'useItOrLoseIt', title: 'Use It or Lose It', items: board.useItOrLoseIt },
  { id: 'usedUp', title: 'Used Up', items: board.usedUp },
  { id: 'idle', title: '', items: lines.filter((line) => !state.enabledProviders.includes(line.provider) || (!line.pinned && !line.group)) },
];
---
<div class="am-priority">
  {groups.map((group) => <section data-priority-group={group.id} hidden={group.id === 'idle' || !group.items.length}>
    <h3>{group.title}</h3>
    <div class="am-priority-items">
      {group.items.map((line) => {
        const row = line.row;
        const bounded = row.kind === 'bounded';
        const usedFraction = bounded ? row.used / row.limit : 0;
        const gauge = priorityGauge(row, 'used');
        const family = accountFamilies.find((family) => family.id === line.provider);
        const name = family?.profiles.find((profile) => profile.id === line.accountID)?.name;
        return <div class="am-priority-row" data-priority-key={line.key} data-line-id={line.id} data-provider={line.provider} data-account-id={line.accountID} data-severity={line.severity} data-spent={String(line.group === 'usedUp')} tabindex="0" aria-label={`${providers.find((provider) => provider.id === line.provider)?.name} ${row.label}`}>
          <span class="am-priority-ring">
            <svg class="am-priority-track" viewBox="0 0 40 40" aria-hidden="true">
              <circle cx="20" cy="20" r="17" class="am-ring-track" />
              <circle cx="20" cy="20" r="17" class="am-ring-progress" pathLength="100" stroke-dasharray={`${gauge.fill} 100`} />
              {gauge.angle !== null && <line class="am-ring-pace" x1="34" y1="20" x2="40" y2="20" transform={`rotate(${gauge.angle} 20 20)`} />}
            </svg>
            <svg class="am-priority-provider" viewBox="0 0 24 24" aria-hidden="true"><use href={`#pi-${line.provider}`} /></svg>
          </span>
          <span class="am-priority-text"><b>{row.label}</b>
            <span class="am-priority-account"><span>{providers.find((provider) => provider.id === line.provider)?.name}</span>{name && <button type="button" class="am-account-label" data-toggle-account-name data-account-name={line.provider} data-account-id={line.accountID}>{name}</button>}</span>
          </span>
          <span class="am-priority-detail">
            {bounded ? <><span class="am-priority-status">Used Up</span><button type="button" class="am-priority-value am-headline" data-toggle-meter><span class="u">{Math.round(usedFraction * 100)}% used</span><span class="l">{Math.round((1 - usedFraction) * 100)}% left</span></button></>
              : <span class="am-priority-plain">{row.kind === 'text' ? row.values[0] : row.kind === 'forecast' ? `${row.probability}% chance` : ''}</span>}
            {(bounded || row.kind === 'forecast') && (row.resetRelative || row.resetAbsolute) && <button type="button" class="am-priority-note am-reset" data-toggle-reset><span class="abs" data-preview-time={row.resetAbsolute?.replace(/^Resets /, '')}>{row.resetAbsolute?.replace(/^Resets /, '')}</span><span class="rel">{row.resetRelative?.replace(/^(Resets in |Within )/, '')}</span></button>}
          </span>
        </div>;
      })}
    </div>
  </section>)}
  <section data-priority-notices hidden><h3>Needs Attention</h3>
    {providers.map((provider) => <div class="am-priority-notice" data-priority-notice={provider.id} hidden><span><b>{provider.name}</b><span>No sample usage for this provider.</span></span><button type="button" class="am-chip" data-go={`account:${provider.id}:default`}>Fix</button></div>)}
  </section>
  <section data-all-clear hidden={!board.allClear}>
    <h3>Running Out</h3>
    <div class="am-clear-row"><span class="am-clear-icon" aria-hidden="true"></span><span>No Matching Limits</span></div>
    <button type="button" class="am-chip" data-clear-view-all data-dashboard-tab="All Usage" hidden={board.pinned.length > 0 || board.usedUp.length > 0 || board.useItOrLoseIt.length > 0}>View All Usage</button>
  </section>
  <div class="am-clear" data-no-limits hidden={!board.noLimits}><b>No Reported Limits</b><button type="button" class="am-chip" data-dashboard-tab="All Usage">View All Usage</button></div>
  <div class="am-clear" data-hidden-priority-limits hidden={!board.hiddenLimits}>
    <b>No usage to show. Check visible metrics in Accounts.</b>
    <button type="button" class="am-chip" data-dashboard-tab="All Usage">View All Usage</button>
  </div>
</div>
